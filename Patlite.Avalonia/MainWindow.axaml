<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Patlite.Avalonia.ViewModels"
        xmlns:local="using:Patlite.Avalonia.Converters"
        xmlns:models="using:Patlite.Avalonia"
        xmlns:pns="using:Patlite.lib"
        xmlns:behaviors="using:Patlite.Avalonia.Behaviors"
        mc:Ignorable="d"
        d:DesignWidth="300"
        d:DesignHeight="520"
        x:Class="Patlite.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="Patlite Controller"
        Icon="avares://Patlite.Avalonia/Assets/logo.png"
        Width="300"
        Height="520"
        MinWidth="280"
        MinHeight="500"
        RequestedThemeVariant="Light"
        FontSize="12">
  <Window.Resources>
    <local:La6ColourToBrushConverter x:Key="ColourBrush" />
    <local:InverseBoolConverter x:Key="InverseBool" />
    <local:FlashToBoolConverter x:Key="IsFlashing" />

    <DataTemplate x:Key="ColourItemTemplate" x:DataType="pns:La6Colour">
      <StackPanel Orientation="Horizontal" Margin="0,1">
        <Ellipse Width="10" Height="10" StrokeThickness="0.5" Stroke="Black"
                 VerticalAlignment="Center"
                 Fill="{Binding Converter={StaticResource ColourBrush}}" />
        <TextBlock Margin="4,0,0,0" Text="{Binding}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="2,1" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="2,0" />
    </Style>
    <Style Selector="Ellipse.tierIndicator">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="StrokeThickness" Value="0.5" />
      <Setter Property="Stroke" Value="Black" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Ellipse.tierIndicator.flashing">
      <Style.Animations>
        <Animation Duration="0:0:0.35" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.25" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,10,Auto,10,*,10,Auto" Margin="12" Grid.IsSharedSizeScope="True">
    <StackPanel Grid.Row="0" Spacing="8">
      <Grid HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="TierLabel" />
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="96" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Spacing="2" HorizontalAlignment="Left">
          <TextBlock Text="IP:" Classes="fieldLabel" />
          <!-- Sized for 16 digits at the controller's 12px text size. -->
          <TextBox Width="130"
                   Text="{Binding Ip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="4" Spacing="2" HorizontalAlignment="Left">
          <TextBlock Text="Port:" Classes="fieldLabel" />
          <TextBox Width="50" Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>

      <Grid HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="TierLabel" />
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="96" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Spacing="3" HorizontalAlignment="Left">
          <TextBlock Text="Flash:" Classes="fieldLabel" />
          <ComboBox Width="92" ItemsSource="{Binding FlashValues}"
                    SelectedItem="{Binding Flash, Mode=TwoWay}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Current:" Classes="label" FontSize="10" />
            <TextBlock FontSize="11" Text="{Binding AppliedFlash}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="4" Spacing="3" HorizontalAlignment="Left">
          <TextBlock Text="Buzzer:" Classes="fieldLabel" />
          <ComboBox Width="96" ItemsSource="{Binding BuzzerValues}"
                    SelectedItem="{Binding Buzzer, Mode=TwoWay}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Current:" Classes="label" FontSize="10" />
            <TextBlock FontSize="11" Text="{Binding AppliedBuzzer}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="TierLabel" />
        <ColumnDefinition Width="92" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="96" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Tier 1" Classes="label" />
      <ComboBox Grid.Row="0" Grid.Column="1" Width="92" Margin="0,3"
                ItemsSource="{Binding La6Colours}" ItemTemplate="{StaticResource ColourItemTemplate}"
                SelectedItem="{Binding Tier1, Mode=TwoWay}" />
      <Ellipse Grid.Row="0" Grid.Column="2" Classes="tierIndicator"
               Classes.flashing="{Binding AppliedFlash, Converter={StaticResource IsFlashing}}"
               Fill="{Binding AppliedTier1, Converter={StaticResource ColourBrush}}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Tier 2" Classes="label" />
      <ComboBox Grid.Row="1" Grid.Column="1" Width="92" Margin="0,3"
                ItemsSource="{Binding La6Colours}" ItemTemplate="{StaticResource ColourItemTemplate}"
                SelectedItem="{Binding Tier2, Mode=TwoWay}" />
      <Ellipse Grid.Row="1" Grid.Column="2" Classes="tierIndicator"
               Classes.flashing="{Binding AppliedFlash, Converter={StaticResource IsFlashing}}"
               Fill="{Binding AppliedTier2, Converter={StaticResource ColourBrush}}" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Tier 3" Classes="label" />
      <ComboBox Grid.Row="2" Grid.Column="1" Width="92" Margin="0,3"
                ItemsSource="{Binding La6Colours}" ItemTemplate="{StaticResource ColourItemTemplate}"
                SelectedItem="{Binding Tier3, Mode=TwoWay}" />
      <Ellipse Grid.Row="2" Grid.Column="2" Classes="tierIndicator"
               Classes.flashing="{Binding AppliedFlash, Converter={StaticResource IsFlashing}}"
               Fill="{Binding AppliedTier3, Converter={StaticResource ColourBrush}}" />

      <TextBlock Grid.Row="3" Grid.Column="0" Text="Tier 4" Classes="label" />
      <ComboBox Grid.Row="3" Grid.Column="1" Width="92" Margin="0,3"
                ItemsSource="{Binding La6Colours}" ItemTemplate="{StaticResource ColourItemTemplate}"
                SelectedItem="{Binding Tier4, Mode=TwoWay}" />
      <Ellipse Grid.Row="3" Grid.Column="2" Classes="tierIndicator"
               Classes.flashing="{Binding AppliedFlash, Converter={StaticResource IsFlashing}}"
               Fill="{Binding AppliedTier4, Converter={StaticResource ColourBrush}}" />

      <TextBlock Grid.Row="4" Grid.Column="0" Text="Tier 5" Classes="label" />
      <ComboBox Grid.Row="4" Grid.Column="1" Width="92" Margin="0,3"
                ItemsSource="{Binding La6Colours}" ItemTemplate="{StaticResource ColourItemTemplate}"
                SelectedItem="{Binding Tier5, Mode=TwoWay}" />
      <Ellipse Grid.Row="4" Grid.Column="2" Classes="tierIndicator"
               Classes.flashing="{Binding AppliedFlash, Converter={StaticResource IsFlashing}}"
               Fill="{Binding AppliedTier5, Converter={StaticResource ColourBrush}}" />

      <ItemsControl Grid.Row="0" Grid.Column="4" Grid.RowSpan="5" ItemsSource="{Binding Presets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:LightPreset">
            <Button Content="{Binding Name}" Margin="0,3" HorizontalAlignment="Stretch"
                    Command="{Binding $parent[Window].DataContext.ApplyAndSendPresetCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Border Grid.Row="4" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1" Padding="8">
      <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" BorderThickness="0"
               behaviors:AutoScrollToEnd.IsEnabled="True"
               Background="#111" Foreground="#DDD" />
    </Border>

    <Grid Grid.Row="6" ColumnDefinitions="Auto,*,60,8,60">
      <TextBlock Grid.Column="0" VerticalAlignment="Center"
                 Text="{Binding IsBusy, StringFormat='Busy: {0}'}" />
      <Button Grid.Column="2" Content="Off" HorizontalAlignment="Stretch" Command="{Binding OffCommand}"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      <Button Grid.Column="4" Content="Send" HorizontalAlignment="Stretch" Command="{Binding SendCommand}"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
    </Grid>
  </Grid>
</Window>
